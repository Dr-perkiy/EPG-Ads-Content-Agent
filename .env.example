# Copy to .env for local runs. In CI these come from GitHub Secrets/Variables.

# --- Anthropic (writes the content) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Behaviour ---
# Keep DRY_RUN=true until you have reviewed a few rendered carousels.
DRY_RUN=true
AGENT_ENABLED=true
PLATFORMS=instagram,facebook

# --- Instagram + Facebook (Meta Graph API) ---
# A long-lived Page access token whose Page is linked to the EPG Ads Instagram
# *Business* account. The same token posts to both the Facebook Page and Instagram.
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
META_PAGE_ID=
META_API_VERSION=v21.0

# Instagram needs a PUBLIC url for each slide image. In GitHub Actions this is
# derived automatically IF the repo is public. To host images yourself instead
# (e.g. on epgads.net), set this to the public folder that serves output/.
IMAGE_BASE_URL=

# --- LinkedIn (Posts + Documents API) ---
# Get the token with: npm run linkedin-token   (see scripts/get-linkedin-token.js)
LINKEDIN_ACCESS_TOKEN=
# Company Page: urn:li:organization:<id>   Personal: urn:li:person:<id>
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202506

# Only needed while generating a LinkedIn token:
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5599/callback
LINKEDIN_SCOPES=w_member_social openid profile
